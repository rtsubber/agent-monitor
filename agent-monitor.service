[Unit]
Description=Agent Monitor API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ron/.openclaw/workspace/agent-monitor
ExecStart=/usr/bin/python3 main.py
EnvironmentFile=/home/ron/.openclaw/workspace/agent-monitor/.env
Restart=always
RestartSec=5

[Install]
WantedBy=default.target